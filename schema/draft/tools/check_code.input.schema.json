{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "maxLength": 128,
      "description": "The file name the step names."
    },
    "content": {
      "type": "string",
      "maxLength": 65536,
      "description": "The whole file, as the learner edited it by hand."
    }
  },
  "required": [
    "file",
    "content"
  ],
  "additionalProperties": false
}
