{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string",
      "maxLength": 64,
      "description": "One allowed branch key from submit_checkpoint."
    },
    "rationale": {
      "type": "string",
      "maxLength": 300,
      "description": "One sentence: why this branch fits the rubric."
    }
  },
  "required": [
    "branch",
    "rationale"
  ],
  "additionalProperties": false
}
