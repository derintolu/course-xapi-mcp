{
  "@context": "https://w3id.org/xapi/profiles/context",
  "id": "https://course-xapi-mcp.sqwrlz.com/xapi",
  "type": "Profile",
  "conformsTo": "https://w3id.org/xapi/profiles#1.0",
  "prefLabel": {
    "en": "course-xapi-mcp"
  },
  "definition": {
    "en": "cmi5-shaped statements for learning that runs inside an AI agent through a Model Context Protocol course server: authored beats, server-validated branching, deterministic checks, planted-bug catches and Open Badges earned. Draft."
  },
  "seeAlso": "https://course-xapi-mcp.sqwrlz.com/spec/draft/",
  "versions": [
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "generatedAtTime": "2026-10-27T00:00:00Z"
    }
  ],
  "author": {
    "type": "Person",
    "name": "Derin Tolu (draft by Claude)",
    "url": "https://github.com/derintolu"
  },
  "concepts": [
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/verbs/placed",
      "type": "Verb",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "placed"
      },
      "definition": {
        "en": "The learner was placed into a learning path at a start lesson, by an agent choosing among authored options that the course server validated. Recorded inside the placement AU session."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/verbs/branched",
      "type": "Verb",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "branched"
      },
      "definition": {
        "en": "After a checkpoint, the learner was sent along one authored branch. The agent chose the branch against the rubric; the course server validated it. The result extensions name the branch, its target and the agent rationale."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/verbs/caught",
      "type": "Verb",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "caught"
      },
      "definition": {
        "en": "The learner found and fixed a bug that the course author planted in AI-written code, as shown by the authored fix checks passing."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/verbs/revealed",
      "type": "Verb",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "revealed"
      },
      "definition": {
        "en": "After the author-set number of failed fix attempts, the course server revealed a planted bug to the learner. A revealed bug does not count as caught."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/activity-types/path",
      "type": "ActivityType",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "learning path"
      },
      "definition": {
        "en": "An ordered sequence of lessons within a course; a cmi5 block."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/activity-types/beat",
      "type": "ActivityType",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "teaching beat"
      },
      "definition": {
        "en": "One authored teaching step inside a lesson: a goal, the key content, and optionally a question for the learner. The agent delivers it in its own words."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/activity-types/checkpoint",
      "type": "ActivityType",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "checkpoint"
      },
      "definition": {
        "en": "A question inside a lesson whose answer decides which authored branch the learner takes. Free-text answers are judged by the agent against an authored rubric; code answers are decided by deterministic checks."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/activity-types/file",
      "type": "ActivityType",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "learner file"
      },
      "definition": {
        "en": "A text file the learner edits by hand and submits for deterministic checks."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/activity-types/planted-bug",
      "type": "ActivityType",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "planted bug"
      },
      "definition": {
        "en": "A deliberate mistake the course author planted in AI-written code. The course server never reveals it to the agent before it is caught or revealed."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/activity-types/achievement",
      "type": "ActivityType",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "achievement"
      },
      "definition": {
        "en": "An Open Badges 3.0 Achievement a learner earned in a course registration."
      }
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/branch",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "branch"
      },
      "definition": {
        "en": "The authored key of the branch taken."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"string\"}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/to",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "branch target"
      },
      "definition": {
        "en": "The AU activity id of the lesson the branch leads to, or null when the branch ends the path."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":[\"string\",\"null\"]}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/rationale",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "judge rationale"
      },
      "definition": {
        "en": "The agent's one-sentence reason for choosing the branch (agent-written, at most 300 characters)."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"string\",\"maxLength\":300}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/checks",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "check results"
      },
      "definition": {
        "en": "Per-check results of the authored deterministic checks, by check index. Empty for planted-bug fixes, so the record does not point at the bug."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"index\":{\"type\":\"integer\"},\"passed\":{\"type\":\"boolean\"}},\"required\":[\"index\",\"passed\"]}}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/start-lesson",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "start lesson"
      },
      "definition": {
        "en": "The AU activity id of the lesson the learner starts at after placement."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"string\"}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/skipped",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "skipped lessons"
      },
      "definition": {
        "en": "AU activity ids of lessons the placement skipped."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"string\"}}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/waive-recommended",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "waive recommended"
      },
      "definition": {
        "en": "On placed or branched in LMS-launched custody: AU ids the course server recommends the LMS waive with reason \"Tested Out\". Only the LMS may waive."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"string\"}}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/carried-over",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "carried over"
      },
      "definition": {
        "en": "On a waived statement with reason \"Administrative\": the lesson was carried over from an earlier record version. It never counts towards a badge."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"boolean\"}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/attempt",
      "type": "ResultExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "attempt"
      },
      "definition": {
        "en": "The 1-based number of this checkpoint attempt within the AU session."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"integer\",\"minimum\":1}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/rules-version",
      "type": "ContextExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "rules version"
      },
      "definition": {
        "en": "The version of the course-xapi-mcp agent rules the course server sent with this step, for example \"0.2\"."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"string\"}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/extensions/custody",
      "type": "ContextExtension",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "record custody"
      },
      "definition": {
        "en": "Who holds the record this statement was written to."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"string\",\"enum\":[\"lms-launched\",\"author-lrs\",\"server-kept\",\"practice\"]}"
    },
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/practice",
      "type": "Activity",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "activityDefinition": {
        "@context": "https://w3id.org/xapi/profiles/activity-context",
        "name": {
          "en": "practice run"
        },
        "description": {
          "en": "Category on every statement of a practice run. A practice run is not an official record and cannot earn badges."
        }
      }
    }
  ],
  "templates": [
    {
      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2/templates/cmi5-launched",
      "type": "StatementTemplate",
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "cmi5 launched"
      },
      "definition": {
        "en": "The LMS role launched the AU (cmi5 9.3.1)."
      },
      "verb": "http://adlnet.gov/expapi/verbs/launched",
      "rules": [
        {
          "location": "$.context.registration",
          "presence": "included"
        },
        {
          "location": "$.context.extensions['https://course-xapi-mcp.sqwrlz.com/xapi/extensions/rules-version']",
          "presence": "included"
        },
        {
          "location": "$.context.extensions['https://course-xapi-mcp.sqwrlz.com/xapi/extensions/custody']",
          "presence": "included",
          "any": [
            "lms-launched",
            "author-lrs",
            "server-kept",
            "practice"
          ]
        },
        {
          "location": "$.context.contextActivities.grouping[*].id",
          "presence": "included",
          "scopeNote": {
            "en": "The publisher id of the AU (from the cmi5 contextTemplate) and the course id."
          }
        },
        {
          "location": "$.version",
          "presence": "excluded"
        },
        {
          "location": "$.context.contextAgents",
          "presence": "excluded"
        },
        {
          "location": "$.context.contextGroups",
          "presence": "excluded"
        },
        {
          "location": "$.actor.mbox",
          "presence": "excluded",
          "scopeNote": {
            "en": "Applies to actors the course server mints. In LMS-launched custody the actor is the LMS-supplied agent, copied verbatim."
          }
        },
        {
          "location": "$.actor.mbox_sha1sum",
          "presence": "excluded",
          "scopeNote": {
            "en": "Applies to actors the course server mints. In LMS-launched custody the actor is the LMS-supplied agent, copied verbatim."
          }
        },
        {
          "location": "$.actor.openid",
          "presence": "excluded",
          "scopeNote": {
            "en": "Applies to actors the course server mints. In LMS-launched custody the actor is the LMS-supplied agent, copied verbatim."
          }
        },
        {
          "location": "$.actor.name",
          "presence": "excluded",
          "scopeNote": {
            "en": "Applies to actors the course server mints. In LMS-launched custody the actor is the LMS-supplied agent, copied verbatim."
          }
        },
        {
          "location": "$.context.extensions['https://w3id.org/xapi/cmi5/context/extensions/sessionid']",
          "presence": "included"
        },
        {
          "location": "$.context.contextActivities.category[*].id",
          "presence": "included",
          "any": [
            "https://w3id.org/xapi/cmi5/context/categories/cmi5"
          ]
        },
        {
          "location": "$.context.contextActivities.category[*].id",
          "none": [
            "https://w3id.org/xapi/cmi5/context/categories/moveon"
          ]
        }
      ]
    },
