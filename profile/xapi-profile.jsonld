      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "passed a learner file"
      },
      "definition": {
        "en": "cmi5 allowed statement inside an AU session, with the AU activity id as parent."
      },
      "verb": "http://adlnet.gov/expapi/verbs/passed",
