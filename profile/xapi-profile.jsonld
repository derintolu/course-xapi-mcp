      "id": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2/patterns/au-session",
      "type": "Pattern",
      "primary": true,
      "inScheme": "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2",
      "prefLabel": {
        "en": "One AU session (informative): launched when the server holds the LMS role, initialized, allowed statements and the defined outcomes, then terminated or abandoned. The conformance suite checks cmi5 order directly."
      },
      "definition": {
        "en": "One AU session (informative): launched when the server holds the LMS role, initialized, allowed statements and the defined outcomes, then terminated or abandoned. The conformance suite checks cmi5 order directly."
