          "scopeNote": {
            "en": "Applies to actors the course server mints. In LMS-launched custody the actor is the LMS-supplied agent, copied verbatim."
          }
        },
        {
          "location": "$.context.extensions['https://w3id.org/xapi/cmi5/context/extensions/sessionid']",
          "presence": "included"
        },
        {
          "location": "$.context.contextActivities.category[*].id",
          "presence": "included",
          "any": [
            "https://course-xapi-mcp.sqwrlz.com/xapi/v0.2"
          ]
        },
        {
          "location": "$.context.contextActivities.category[*].id",
          "none": [
            "https://w3id.org/xapi/cmi5/context/categories/cmi5",
            "https://w3id.org/xapi/cmi5/context/categories/moveon"
          ]
        },
        {
          "location": "$.context.contextActivities.parent[*].id",
          "presence": "included",
          "scopeNote": {
            "en": "The AU activity id."
          }
        },
        {
          "location": "$.result.success",
          "presence": "included",
          "all": [
            true
          ]
        }
      ]
